# Local development. The existing test project is configured via untracked .env.local.
VITE_FIREBASE_CONFIG='{"apiKey":"YOUR_WEB_API_KEY","projectId":"YOUR_PROJECT_ID","appId":"YOUR_WEB_APP_ID"}'
# For a registered App Check debug token on localhost only, use an untracked .env.local.
VITE_APPCHECK_DEBUG_TOKEN=

# Published builds use a separate Firebase web configuration and production App Check site key.
VITE_PUBLIC_FIREBASE_CONFIG=
VITE_APPCHECK_SITE_KEY=
